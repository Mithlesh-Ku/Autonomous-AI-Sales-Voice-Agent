# =============================================================================
# Autonomous AI Sales Voice Agent - Environment Configuration
# Copy this file to .env and fill in your API keys.
# Leave keys empty to run in local deterministic demo mode with browser voice!
# =============================================================================

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM Provider: openai | groq | gemini | mock ---
# When set to openai/groq/gemini without a key, the app safely falls back to mock mode.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Voice Pipeline: STT & TTS ---
# STT_PROVIDER: deepgram | browser
STT_PROVIDER=browser
DEEPGRAM_API_KEY=

# TTS_PROVIDER: openai | elevenlabs | browser
TTS_PROVIDER=browser
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Vector Store & Embeddings (ChromaDB) ---
CHROMA_PERSIST_DIR=./data/chroma_db
# EMBEDDING_PROVIDER: openai | local
EMBEDDING_PROVIDER=local

# --- Database (SQLite by default; swap to postgresql+psycopg://... for prod) ---
DATABASE_URL=sqlite:///./data/sales_agent.db
